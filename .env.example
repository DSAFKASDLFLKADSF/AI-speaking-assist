# =============================================================================
# AI Speaking Trainer — environment template
# Copy to .env.local and fill in your values:
#   cp .env.example .env.local
# =============================================================================

# App
NEXT_PUBLIC_APP_NAME=AI Speaking Trainer
NEXT_PUBLIC_APP_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Supabase
# https://supabase.com/dashboard/project/_/settings/api
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
NEXT_PUBLIC_SUPABASE_AUDIO_BUCKET=audio-responses

# Optional: server-side admin writes (never expose to the browser)
# SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# -----------------------------------------------------------------------------
# Python speech analysis (Listen & Repeat + Virtual Interview)
# Transcription: AssemblyAI (python/.env) | Scoring: Zhipu GLM (python/.env)
# -----------------------------------------------------------------------------
PYTHON_SPEECH_API_URL=http://localhost:8000
# PYTHON_SPEECH_API_KEY=your-python-api-bearer-token
# PYTHON_SPEECH_API_TIMEOUT_MS=120000

# OPENAI_API_KEY is not required when using the Python service (see python/.env)
